<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <!-- The deploy workflow runs on GitHub Actions, which exposes the commit as GITHUB_SHA. The SDK appends SourceRevisionId to
       the InformationalVersion ("1.0.0+<commit>"), which the administration overview shows as the deployed version.
       Local builds have no commit and show only the version. -->
  <PropertyGroup Condition="'$(GITHUB_SHA)' != ''">
    <SourceRevisionId>$(GITHUB_SHA)</SourceRevisionId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Trazo.Application/Trazo.Application.csproj" />
    <ProjectReference Include="../Trazo.Infrastructure/Trazo.Infrastructure.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <!-- Explicit runtime dependency: DatabaseInitialization loads EF Relational from the API host. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageReference Include="Google.Apis.Auth" Version="1.78.0" />
    <PackageReference Include="MailKit" Version="4.18.2" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../Trazo.Infrastructure/Seeds/**/*.json"
             Link="Seeds/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../Trazo.Infrastructure/Seeds/exercise-images/**/*"
             Link="Seeds/exercise-images/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
