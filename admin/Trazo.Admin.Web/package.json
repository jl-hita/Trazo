{
  "name": "trazo-admin-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "build": "npm run check:types && npm test && npm run test:angular && ng build",
    "test": "node --test scripts/*.test.mjs",
    "check:types": "node scripts/check-no-explicit-any.mjs",
    "test:angular": "ng test --watch=false --no-progress --coverage"
  },
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.2.26",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.2.26",
    "rxjs": "~7.8.2"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^21.0.0",
    "typescript": "~5.9.3",
    "jsdom": "^27.0.0",
    "vitest": "^4.0.0",
    "@vitest/coverage-v8": "^4.0.0"
  }
}
